{
  "name": "Gold Model",
  "doctype": "DocType",
  "module": "Pipeline",
  "issingle": 0,
  "istable": 0,
  "editable_grid": 0,
  "engine": "InnoDB",
  "track_changes": 1,
  "autoname": "field:model_name",
  "fields": [
    {
      "fieldname": "model_name",
      "fieldtype": "Data",
      "label": "Model Name",
      "reqd": 1,
      "unique": 1,
      "in_list_view": 1,
      "description": "dbt gold model name, e.g. gold_trial_balance. Must match a model under models.open_epm.gold in dbt_project.yml."
    },
    {
      "fieldname": "build_domain",
      "fieldtype": "Select",
      "label": "Build Domain",
      "options": "staging\nactuals\nscenarios\nconsolidation",
      "reqd": 1,
      "in_list_view": 1,
      "description": "Build Governance domain. Emitted as the dbt tag domain:<value>, which the governed build selects with tag:domain:<value>."
    },
    {
      "fieldname": "col_break_1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "description",
      "fieldtype": "Small Text",
      "label": "Description"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    },
    {
      "role": "EPM Admin",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    }
  ]
}
