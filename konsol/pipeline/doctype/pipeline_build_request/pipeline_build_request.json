{
  "name": "Pipeline Build Request",
  "doctype": "DocType",
  "module": "Pipeline",
  "issingle": 0,
  "istable": 0,
  "editable_grid": 0,
  "engine": "InnoDB",
  "track_changes": 1,
  "autoname": "PBR-.#####",
  "fields": [
    {
      "fieldname": "build_scope",
      "fieldtype": "Select",
      "label": "Build Scope",
      "options": "staging\nactuals\nscenarios\nconsolidation\nreporting\nfull",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "risk_level",
      "fieldtype": "Select",
      "label": "Risk Level",
      "options": "low\nmedium\nhigh",
      "read_only": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "trigger_source",
      "fieldtype": "Select",
      "label": "Trigger Source",
      "options": "auto\nmanual",
      "default": "manual",
      "in_list_view": 1
    },
    {
      "fieldname": "col_break_1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "trigger_doctype",
      "fieldtype": "Data",
      "label": "Trigger DocType",
      "read_only": 1
    },
    {
      "fieldname": "trigger_docname",
      "fieldtype": "Data",
      "label": "Trigger DocName",
      "read_only": 1
    },
    {
      "fieldname": "workflow_state",
      "fieldtype": "Select",
      "label": "Workflow State",
      "options": "Draft\nPending Review\nApproved\nRunning\nCompleted\nFailed\nCancelled",
      "default": "Draft",
      "in_list_view": 1,
      "reqd": 1
    },
    {
      "fieldname": "people_section",
      "fieldtype": "Section Break",
      "label": "People"
    },
    {
      "fieldname": "requested_by",
      "fieldtype": "Link",
      "label": "Requested By",
      "options": "User",
      "read_only": 1
    },
    {
      "fieldname": "approved_by",
      "fieldtype": "Link",
      "label": "Approved By",
      "options": "User",
      "read_only": 1
    },
    {
      "fieldname": "sync_info_section",
      "fieldtype": "Section Break",
      "label": "Airbyte Sync Info",
      "collapsible": 1
    },
    {
      "fieldname": "sync_time_display",
      "fieldtype": "Data",
      "label": "Last Sync Time",
      "read_only": 1
    },
    {
      "fieldname": "sync_status_display",
      "fieldtype": "Data",
      "label": "Sync Status",
      "read_only": 1
    },
    {
      "fieldname": "sync_rows_display",
      "fieldtype": "Data",
      "label": "GL Rows in epm_raw",
      "read_only": 1
    },
    {
      "fieldname": "timing_section",
      "fieldtype": "Section Break",
      "label": "Timing"
    },
    {
      "fieldname": "started_at",
      "fieldtype": "Datetime",
      "label": "Started At",
      "read_only": 1
    },
    {
      "fieldname": "completed_at",
      "fieldtype": "Datetime",
      "label": "Completed At",
      "read_only": 1
    },
    {
      "fieldname": "duration_seconds",
      "fieldtype": "Float",
      "label": "Duration (seconds)",
      "read_only": 1
    },
    {
      "fieldname": "output_section",
      "fieldtype": "Section Break",
      "label": "Build Output",
      "collapsible": 1
    },
    {
      "fieldname": "preflight_result",
      "fieldtype": "Small Text",
      "label": "Preflight Result",
      "read_only": 1
    },
    {
      "fieldname": "build_output",
      "fieldtype": "Long Text",
      "label": "Build Output",
      "read_only": 1
    },
    {
      "fieldname": "error_message",
      "fieldtype": "Long Text",
      "label": "Error Message",
      "read_only": 1
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    },
    {
      "role": "EPM Admin",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    },
    {
      "role": "EPM Analyst",
      "read": 1,
      "write": 1,
      "create": 1
    },
    {
      "role": "EPM User",
      "read": 1
    }
  ]
}
