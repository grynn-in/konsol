{
  "name": "EPM Settings",
  "doctype": "DocType",
  "module": "Pipeline",
  "issingle": 1,
  "istable": 0,
  "editable_grid": 0,
  "engine": "InnoDB",
  "track_changes": 0,
  "fields": [
    {
      "fieldname": "clickhouse_section",
      "fieldtype": "Section Break",
      "label": "ClickHouse Connection"
    },
    {
      "fieldname": "clickhouse_host",
      "fieldtype": "Data",
      "label": "ClickHouse Host",
      "default": "localhost"
    },
    {
      "fieldname": "clickhouse_port",
      "fieldtype": "Data",
      "label": "ClickHouse Port",
      "default": "8123"
    },
    {
      "fieldname": "clickhouse_user",
      "fieldtype": "Data",
      "label": "ClickHouse User",
      "default": "default"
    },
    {
      "fieldname": "clickhouse_password",
      "fieldtype": "Password",
      "label": "ClickHouse Password"
    },
    {
      "fieldname": "clickhouse_secure",
      "fieldtype": "Check",
      "label": "Use HTTPS (TLS)",
      "default": "0",
      "description": "Connect to ClickHouse over HTTPS so credentials and query results are encrypted in transit. Required when ClickHouse is reached over any non-loopback network."
    },
    {
      "fieldname": "clickhouse_verify_tls",
      "fieldtype": "Check",
      "label": "Verify TLS Certificate",
      "default": "1",
      "depends_on": "clickhouse_secure",
      "description": "Validate the ClickHouse server certificate. Disable only for self-signed certs on a trusted network."
    },
    {
      "fieldname": "airbyte_section",
      "fieldtype": "Section Break",
      "label": "Airbyte Connection"
    },
    {
      "fieldname": "airbyte_api_url",
      "fieldtype": "Data",
      "label": "Airbyte API URL",
      "default": "http://localhost:8000"
    },
    {
      "fieldname": "airbyte_connection_id",
      "fieldtype": "Data",
      "label": "Airbyte Connection ID"
    },
    {
      "fieldname": "airbyte_client_id",
      "fieldtype": "Data",
      "label": "Airbyte Client ID"
    },
    {
      "fieldname": "airbyte_client_secret",
      "fieldtype": "Password",
      "label": "Airbyte Client Secret"
    },
    {
      "fieldname": "webhook_secret",
      "fieldtype": "Password",
      "label": "Webhook Secret",
      "description": "Shared secret for Airbyte webhook auth (X-Webhook-Secret header)"
    },
    {
      "fieldname": "d365_writeback_section",
      "fieldtype": "Section Break",
      "label": "D365 F&O Budget Write-Back"
    },
    {
      "fieldname": "enable_d365_budget_writeback",
      "fieldtype": "Check",
      "label": "Enable D365 Budget Write-Back",
      "default": "0",
      "description": "Push approved budgets to D365 BudgetRegisterEntries (one-way; ClickHouse stays source of truth)"
    },
    {
      "fieldname": "d365_resource_url",
      "fieldtype": "Data",
      "label": "D365 Resource URL",
      "description": "e.g. https://yourorg.operations.dynamics.com"
    },
    {
      "fieldname": "d365_tenant_id",
      "fieldtype": "Data",
      "label": "Azure AD Tenant ID"
    },
    {
      "fieldname": "d365_client_id",
      "fieldtype": "Data",
      "label": "D365 Client ID"
    },
    {
      "fieldname": "d365_client_secret",
      "fieldtype": "Password",
      "label": "D365 Client Secret"
    },
    {
      "fieldname": "d365_fiscal_year_start_month",
      "fieldtype": "Int",
      "label": "Fiscal Year Start Month",
      "default": "1",
      "depends_on": "enable_d365_budget_writeback",
      "description": "Month when the D365 fiscal year begins (1=Jan, 4=Apr, 7=Jul, 10=Oct). Maps budget period numbers to OData AccountingDate. For 4-4-5 calendars, supply a CustomFiscalCalendar programmatically. NEEDS-LIVE-TENANT: must match the Fiscal calendar configured in D365 F&O for the target legal entity."
    },
    {
      "fieldname": "airbyte_sync_status_section",
      "fieldtype": "Section Break",
      "label": "Airbyte Sync Status"
    },
    {
      "fieldname": "last_airbyte_sync_at",
      "fieldtype": "Datetime",
      "label": "Last Airbyte Sync At",
      "read_only": 1
    },
    {
      "fieldname": "last_airbyte_sync_status",
      "fieldtype": "Select",
      "label": "Last Airbyte Sync Status",
      "options": "\nSuccess\nFailed\nPartial\nRunning",
      "read_only": 1
    },
    {
      "fieldname": "last_airbyte_sync_rows",
      "fieldtype": "Int",
      "label": "Last Airbyte Sync Rows",
      "read_only": 1
    },
    {
      "fieldname": "dbt_section",
      "fieldtype": "Section Break",
      "label": "dbt Configuration"
    },
    {
      "fieldname": "dbt_project_path",
      "fieldtype": "Data",
      "label": "dbt Project Path",
      "default": "/home/pd/open_epm/dbt_project"
    },
    {
      "fieldname": "access_control_section",
      "fieldtype": "Section Break",
      "label": "Access Control"
    },
    {
      "fieldname": "entity_permission_doctype",
      "fieldtype": "Link",
      "options": "DocType",
      "label": "Entity Permission DocType",
      "description": "DocType whose User Permissions restrict which entities (data areas) a user may query via the EPM API. Leave blank to allow all authenticated users to query all entities."
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1
    }
  ]
}
