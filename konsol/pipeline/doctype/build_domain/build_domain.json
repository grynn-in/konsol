{
  "name": "Build Domain",
  "doctype": "DocType",
  "module": "Pipeline",
  "issingle": 0,
  "istable": 0,
  "editable_grid": 0,
  "engine": "InnoDB",
  "track_changes": 1,
  "autoname": "field:domain_name",
  "fields": [
    {
      "fieldname": "domain_name",
      "fieldtype": "Data",
      "label": "Domain Name",
      "reqd": 1,
      "unique": 1,
      "in_list_view": 1,
      "description": "Build Governance domain — lowercase identifier, e.g. actuals. Emitted as the dbt tag domain:<name> and selected with tag:domain:<name>."
    },
    {
      "fieldname": "requires_raw_data",
      "fieldtype": "Check",
      "label": "Requires Raw Data",
      "default": "0",
      "in_list_view": 1,
      "description": "When checked, a build of this domain preflight-checks that epm_raw (Airbyte/connector) data is available before running."
    },
    {
      "fieldname": "col_break_1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "description",
      "fieldtype": "Small Text",
      "label": "Description"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    },
    {
      "role": "EPM Admin",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    }
  ]
}
