{
  "name": "Allocation Rule",
  "doctype": "DocType",
  "module": "Allocation",
  "issingle": 0,
  "istable": 0,
  "editable_grid": 0,
  "engine": "InnoDB",
  "track_changes": 1,
  "autoname": "field:allocation_rule_id",
  "fields": [
    {
      "fieldname": "tab_allocation_rule",
      "fieldtype": "Tab Break",
      "label": "Allocation Rule"
    },
    {
      "fieldname": "allocation_rule_id",
      "fieldtype": "Data",
      "label": "Rule ID",
      "reqd": 1,
      "unique": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "rule_name",
      "fieldtype": "Data",
      "label": "Rule Name",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "step_order",
      "fieldtype": "Int",
      "label": "Step Order",
      "reqd": 1,
      "in_list_view": 1,
      "description": "Execution order: 1, 2, 3, ..."
    },
    {
      "fieldname": "col_break_1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "source_account",
      "fieldtype": "Data",
      "label": "Source Account",
      "reqd": 1
    },
    {
      "fieldname": "source_cost_center",
      "fieldtype": "Data",
      "label": "Source Cost Center",
      "reqd": 1
    },
    {
      "fieldname": "driver_type",
      "fieldtype": "Select",
      "label": "Driver Type",
      "options": "headcount\nrevenue\nsqm\ncomposite\nconditional\ntiered",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "target_account",
      "fieldtype": "Data",
      "label": "Target Account",
      "reqd": 1
    },
    {
      "fieldname": "method_section",
      "fieldtype": "Section Break",
      "label": "Allocation Method (PRD-17/18)"
    },
    {
      "fieldname": "allocation_method",
      "fieldtype": "Select",
      "label": "Allocation Method",
      "options": "step_down\nreciprocal",
      "default": "step_down",
      "description": "PRD-18: step_down = standard cascading; reciprocal = circular with convergence"
    },
    {
      "fieldname": "driver_formula",
      "fieldtype": "Small Text",
      "label": "Driver Formula",
      "description": "PRD-19: Composite formula (e.g. 'headcount*0.6+sqm*0.4') or CASE expression"
    },
    {
      "fieldname": "tab_tiers",
      "fieldtype": "Tab Break",
      "label": "Allocation Tiers"
    },
    {
      "fieldname": "tiers_section",
      "fieldtype": "Section Break",
      "label": "Allocation Tiers (PRD-20)",
      "depends_on": "eval:doc.driver_type=='tiered'"
    },
    {
      "fieldname": "allocation_tiers",
      "fieldtype": "Table",
      "label": "Tiers",
      "options": "Allocation Tier"
    },
    {
      "fieldname": "tab_details",
      "fieldtype": "Tab Break",
      "label": "Details"
    },
    {
      "fieldname": "details_section",
      "fieldtype": "Section Break",
      "label": "Details"
    },
    {
      "fieldname": "description",
      "fieldtype": "Small Text",
      "label": "Description"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    }
  ]
}
