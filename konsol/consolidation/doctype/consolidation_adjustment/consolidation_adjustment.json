{
  "name": "Consolidation Adjustment",
  "doctype": "DocType",
  "module": "Consolidation",
  "issingle": 0,
  "istable": 0,
  "is_submittable": 1,
  "editable_grid": 1,
  "engine": "InnoDB",
  "track_changes": 1,
  "autoname": "format:CADJ-{journal_id}-{####}",
  "fields": [
    {
      "fieldname": "tab_adjustment",
      "fieldtype": "Tab Break",
      "label": "Adjustment"
    },
    {
      "fieldname": "consolidation_group",
      "fieldtype": "Data",
      "label": "Consolidation Group",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "adjustment_type",
      "fieldtype": "Select",
      "label": "Adjustment Type",
      "options": "topside\nreclassification",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "journal_id",
      "fieldtype": "Data",
      "label": "Journal ID",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "col_break_1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "data_area_id",
      "fieldtype": "Data",
      "label": "Entity",
      "reqd": 1
    },
    {
      "fieldname": "fiscal_year",
      "fieldtype": "Int",
      "label": "Fiscal Year",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "fiscal_period",
      "fieldtype": "Int",
      "label": "Fiscal Period",
      "reqd": 1
    },
    {
      "fieldname": "main_account",
      "fieldtype": "Data",
      "label": "Main Account",
      "reqd": 1
    },
    {
      "fieldname": "amounts_section",
      "fieldtype": "Section Break",
      "label": "Amounts"
    },
    {
      "fieldname": "debit_amount",
      "fieldtype": "Currency",
      "label": "Debit Amount",
      "reqd": 1,
      "default": "0"
    },
    {
      "fieldname": "credit_amount",
      "fieldtype": "Currency",
      "label": "Credit Amount",
      "reqd": 1,
      "default": "0"
    },
    {
      "fieldname": "tab_details",
      "fieldtype": "Tab Break",
      "label": "Details"
    },
    {
      "fieldname": "details_section",
      "fieldtype": "Section Break",
      "label": "Details"
    },
    {
      "fieldname": "description",
      "fieldtype": "Small Text",
      "label": "Description"
    },
    {
      "fieldname": "posted_by",
      "fieldtype": "Link",
      "label": "Posted By",
      "options": "User",
      "default": "__user"
    },
    {
      "fieldname": "tab_workflow",
      "fieldtype": "Tab Break",
      "label": "Workflow"
    },
    {
      "fieldname": "workflow_section",
      "fieldtype": "Section Break",
      "label": "Workflow (PRD-16)"
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Status",
      "options": "Draft\nPending Approval\nApproved\nReversed",
      "default": "Draft",
      "in_list_view": 1,
      "read_only_depends_on": "eval:!frappe.user.has_role('System Manager')"
    },
    {
      "fieldname": "approved_by",
      "fieldtype": "Link",
      "label": "Approved By",
      "options": "User",
      "read_only": 1
    },
    {
      "fieldname": "approved_at",
      "fieldtype": "Datetime",
      "label": "Approved At",
      "read_only": 1
    },
    {
      "fieldname": "col_break_workflow",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "reversal_journal_id",
      "fieldtype": "Data",
      "label": "Reversal Journal ID",
      "read_only": 1,
      "description": "Links to the original journal this reverses"
    },
    {
      "fieldname": "auto_reverse_period",
      "fieldtype": "Int",
      "label": "Auto-Reverse After (periods)",
      "default": "0",
      "description": "0 = no auto-reversal. N = reverse in period + N"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "submit": 1,
      "cancel": 1,
      "amend": 1
    }
  ]
}
