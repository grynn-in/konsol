{
  "name": "IC Balance",
  "doctype": "DocType",
  "module": "Consolidation",
  "issingle": 0,
  "istable": 0,
  "is_submittable": 1,
  "editable_grid": 1,
  "engine": "InnoDB",
  "track_changes": 1,
  "autoname": "format:ICB-{selling_entity}-{buying_entity}-{fiscal_year}-P{fiscal_period}",
  "fields": [
    {
      "fieldname": "selling_entity",
      "fieldtype": "Data",
      "label": "Selling Entity",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "buying_entity",
      "fieldtype": "Data",
      "label": "Buying Entity",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "fiscal_year",
      "fieldtype": "Int",
      "label": "Fiscal Year",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "fiscal_period",
      "fieldtype": "Int",
      "label": "Fiscal Period",
      "reqd": 1
    },
    {
      "fieldname": "col_break_1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "ic_sales_amount",
      "fieldtype": "Currency",
      "label": "IC Sales Amount",
      "reqd": 1,
      "in_list_view": 1,
      "default": "0"
    },
    {
      "fieldname": "ending_inventory_from_ic",
      "fieldtype": "Currency",
      "label": "Ending Inventory from IC",
      "reqd": 1,
      "in_list_view": 1,
      "default": "0",
      "description": "PRD-15: Inventory held by buying entity that originated from IC purchases"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "submit": 1,
      "cancel": 1
    }
  ]
}
