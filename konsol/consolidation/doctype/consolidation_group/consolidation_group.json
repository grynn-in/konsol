{
  "name": "Consolidation Group",
  "doctype": "DocType",
  "module": "Consolidation",
  "issingle": 0,
  "istable": 0,
  "editable_grid": 1,
  "engine": "InnoDB",
  "track_changes": 1,
  "autoname": "format:CG-{consolidation_group}-{data_area_id}",
  "fields": [
    {
      "fieldname": "consolidation_group",
      "fieldtype": "Data",
      "label": "Consolidation Group",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "data_area_id",
      "fieldtype": "Data",
      "label": "Entity",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "entity_name",
      "fieldtype": "Data",
      "label": "Entity Name",
      "reqd": 1
    },
    {
      "fieldname": "col_break_1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "ownership_pct",
      "fieldtype": "Float",
      "label": "Ownership %",
      "reqd": 1,
      "in_list_view": 1,
      "description": "0-100"
    },
    {
      "fieldname": "reporting_currency",
      "fieldtype": "Data",
      "label": "Reporting Currency",
      "reqd": 1,
      "default": "USD"
    },
    {
      "fieldname": "consolidation_method",
      "fieldtype": "Select",
      "label": "Consolidation Method",
      "options": "full\nproportional\nequity",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "hierarchy_section",
      "fieldtype": "Section Break",
      "label": "Hierarchy (PRD-8)"
    },
    {
      "fieldname": "parent_group",
      "fieldtype": "Link",
      "label": "Parent Group",
      "options": "Consolidation Group",
      "description": "Parent consolidation group for multi-level hierarchy"
    },
    {
      "fieldname": "hierarchy_level",
      "fieldtype": "Int",
      "label": "Hierarchy Level",
      "default": "1",
      "description": "Depth in the consolidation tree (1 = top)"
    },
    {
      "fieldname": "col_break_hierarchy",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "goodwill_method",
      "fieldtype": "Select",
      "label": "Goodwill Method",
      "options": "partial\nfull",
      "default": "partial",
      "description": "PRD-13: partial = NCI at proportional net assets; full = NCI at fair value"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    }
  ]
}
