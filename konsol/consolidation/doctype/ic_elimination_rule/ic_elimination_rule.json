{
  "name": "IC Elimination Rule",
  "doctype": "DocType",
  "module": "Consolidation",
  "issingle": 0,
  "istable": 0,
  "editable_grid": 0,
  "engine": "InnoDB",
  "track_changes": 1,
  "autoname": "field:rule_id",
  "fields": [
    {
      "fieldname": "tab_rule",
      "fieldtype": "Tab Break",
      "label": "Rule"
    },
    {
      "fieldname": "rule_id",
      "fieldtype": "Data",
      "label": "Rule ID",
      "reqd": 1,
      "unique": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "rule_name",
      "fieldtype": "Data",
      "label": "Rule Name",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "rule_type",
      "fieldtype": "Select",
      "label": "Rule Type",
      "options": "balance\nunrealized_profit",
      "default": "balance",
      "reqd": 1,
      "in_list_view": 1,
      "description": "PRD-15: balance = standard IC elimination; unrealized_profit = inventory margin elimination"
    },
    {
      "fieldname": "col_break_1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "debit_account",
      "fieldtype": "Data",
      "label": "Debit Account",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "credit_account",
      "fieldtype": "Data",
      "label": "Credit Account",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "tab_entity_patterns",
      "fieldtype": "Tab Break",
      "label": "Entity Patterns"
    },
    {
      "fieldname": "entity_patterns_section",
      "fieldtype": "Section Break",
      "label": "Entity Patterns"
    },
    {
      "fieldname": "debit_entity_pattern",
      "fieldtype": "Data",
      "label": "Debit Entity Pattern",
      "default": "*"
    },
    {
      "fieldname": "credit_entity_pattern",
      "fieldtype": "Data",
      "label": "Credit Entity Pattern",
      "default": "*"
    },
    {
      "fieldname": "tab_unrealized_profit",
      "fieldtype": "Tab Break",
      "label": "Unrealized Profit"
    },
    {
      "fieldname": "unrealized_profit_section",
      "fieldtype": "Section Break",
      "label": "Unrealized Profit (PRD-15)",
      "depends_on": "eval:doc.rule_type=='unrealized_profit'"
    },
    {
      "fieldname": "margin_pct",
      "fieldtype": "Percent",
      "label": "Margin %",
      "default": "0",
      "description": "Gross margin percentage for unrealized profit calculation"
    },
    {
      "fieldname": "asset_account",
      "fieldtype": "Data",
      "label": "Asset Account",
      "description": "Inventory/asset account to credit for unrealized profit elimination"
    },
    {
      "fieldname": "tab_details",
      "fieldtype": "Tab Break",
      "label": "Details"
    },
    {
      "fieldname": "details_section",
      "fieldtype": "Section Break",
      "label": "Details"
    },
    {
      "fieldname": "description",
      "fieldtype": "Small Text",
      "label": "Description"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    }
  ]
}
