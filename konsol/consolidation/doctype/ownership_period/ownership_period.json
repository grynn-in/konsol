{
  "name": "Ownership Period",
  "doctype": "DocType",
  "module": "Consolidation",
  "issingle": 0,
  "istable": 0,
  "is_submittable": 1,
  "editable_grid": 1,
  "engine": "InnoDB",
  "track_changes": 1,
  "autoname": "format:OP-{consolidation_group}-{data_area_id}-{effective_date}",
  "fields": [
    {
      "fieldname": "tab_ownership",
      "fieldtype": "Tab Break",
      "label": "Ownership"
    },
    {
      "fieldname": "consolidation_group",
      "fieldtype": "Data",
      "label": "Consolidation Group",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "data_area_id",
      "fieldtype": "Data",
      "label": "Entity",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "effective_date",
      "fieldtype": "Date",
      "label": "Effective Date",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "end_date",
      "fieldtype": "Date",
      "label": "End Date",
      "default": "9999-12-31"
    },
    {
      "fieldname": "col_break_1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "ownership_pct",
      "fieldtype": "Float",
      "label": "Ownership %",
      "reqd": 1,
      "in_list_view": 1,
      "description": "0-100"
    },
    {
      "fieldname": "consolidation_method",
      "fieldtype": "Select",
      "label": "Consolidation Method",
      "options": "full\nproportional\nequity\nnone",
      "default": "full",
      "reqd": 1
    },
    {
      "fieldname": "tab_acquisition",
      "fieldtype": "Tab Break",
      "label": "Acquisition"
    },
    {
      "fieldname": "acquisition_section",
      "fieldtype": "Section Break",
      "label": "Acquisition (PRD-11)"
    },
    {
      "fieldname": "acquisition_date",
      "fieldtype": "Date",
      "label": "Acquisition Date",
      "description": "Date of step acquisition"
    },
    {
      "fieldname": "is_first_acquisition",
      "fieldtype": "Check",
      "label": "First Acquisition",
      "default": "0",
      "description": "Check if this is the initial acquisition (triggers goodwill calculation)"
    },
    {
      "fieldname": "col_break_acq",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "acquisition_price",
      "fieldtype": "Currency",
      "label": "Acquisition Price",
      "default": "0"
    },
    {
      "fieldname": "fair_value_adjustment",
      "fieldtype": "Currency",
      "label": "Fair Value Adjustment",
      "default": "0"
    },
    {
      "fieldname": "tab_disposal",
      "fieldtype": "Tab Break",
      "label": "Disposal"
    },
    {
      "fieldname": "disposal_section",
      "fieldtype": "Section Break",
      "label": "Disposal (PRD-12)"
    },
    {
      "fieldname": "is_disposal",
      "fieldtype": "Check",
      "label": "Is Disposal",
      "default": "0"
    },
    {
      "fieldname": "disposal_date",
      "fieldtype": "Date",
      "label": "Disposal Date"
    },
    {
      "fieldname": "disposal_price",
      "fieldtype": "Currency",
      "label": "Disposal Price",
      "default": "0"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "submit": 1,
      "cancel": 1
    }
  ]
}
