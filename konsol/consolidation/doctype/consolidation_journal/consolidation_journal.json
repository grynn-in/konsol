{
 "name": "Consolidation Journal",
 "doctype": "DocType",
 "module": "Consolidation",
 "issingle": 0,
 "istable": 0,
 "is_submittable": 1,
 "editable_grid": 1,
 "engine": "InnoDB",
 "track_changes": 1,
 "autoname": "CJ-.#####",
 "title_field": "description",
 "fields": [
  {
   "fieldname": "tab_journal",
   "fieldtype": "Tab Break",
   "label": "Journal"
  },
  {
   "fieldname": "consolidation_group",
   "fieldtype": "Data",
   "label": "Consolidation Group",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "adjustment_type",
   "fieldtype": "Select",
   "label": "Adjustment Type",
   "options": "topside\nreclassification",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "col_break_1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "fiscal_year",
   "fieldtype": "Int",
   "label": "Fiscal Year",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "fiscal_period",
   "fieldtype": "Int",
   "label": "Fiscal Period",
   "reqd": 1
  },
  {
   "fieldname": "currency",
   "fieldtype": "Link",
   "label": "Reporting Currency",
   "options": "Currency",
   "read_only": 1,
   "description": "The group's reporting currency. Every amount on this journal is in it."
  },
  {
   "fieldname": "details_section",
   "fieldtype": "Section Break",
   "label": "Details"
  },
  {
   "fieldname": "description",
   "fieldtype": "Small Text",
   "label": "Description"
  },
  {
   "fieldname": "lines_section",
   "fieldtype": "Section Break",
   "label": "Lines"
  },
  {
   "fieldname": "lines",
   "fieldtype": "Table",
   "label": "Lines",
   "options": "Consolidation Journal Line",
   "reqd": 1
  },
  {
   "fieldname": "amounts_section",
   "fieldtype": "Section Break",
   "label": "Amounts"
  },
  {
   "fieldname": "total_debit",
   "fieldtype": "Currency",
   "label": "Total Debit",
   "options": "currency",
   "read_only": 1
  },
  {
   "fieldname": "col_break_totals",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "total_credit",
   "fieldtype": "Currency",
   "label": "Total Credit",
   "options": "currency",
   "read_only": 1
  },
  {
   "fieldname": "reversal_section",
   "fieldtype": "Section Break",
   "label": "Reversal"
  },
  {
   "fieldname": "reverse_fiscal_year",
   "fieldtype": "Int",
   "label": "Reverse In Fiscal Year",
   "description": "Leave both blank for no reversal. Otherwise the reversal posts in exactly this period. It must be a declared Regular period after this journal's own, and Open when the journal is approved (konsol#305-D2-11)."
  },
  {
   "fieldname": "col_break_reversal",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "reverse_fiscal_period",
   "fieldtype": "Int",
   "label": "Reverse In Fiscal Period",
   "description": "Leave both blank for no reversal. Otherwise the reversal posts in exactly this period. It must be a declared Regular period after this journal's own, and Open when the journal is approved (konsol#305-D2-11)."
  },
  {
   "fieldname": "tab_workflow",
   "fieldtype": "Tab Break",
   "label": "Workflow"
  },
  {
   "fieldname": "workflow_section",
   "fieldtype": "Section Break",
   "label": "Workflow"
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "Draft\nPending Approval\nApproved\nReversed",
   "default": "Draft",
   "in_list_view": 1,
   "read_only": 1
  },
  {
   "fieldname": "approved_by",
   "fieldtype": "Link",
   "label": "Approved By",
   "options": "User",
   "read_only": 1
  },
  {
   "fieldname": "col_break_workflow",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "approved_at",
   "fieldtype": "Datetime",
   "label": "Approved At",
   "read_only": 1
  },
  {
   "fieldname": "amended_from",
   "fieldtype": "Link",
   "label": "Amended From",
   "options": "Consolidation Journal",
   "no_copy": 1,
   "print_hide": 1,
   "read_only": 1,
   "search_index": 1
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "submit": 1,
   "cancel": 1,
   "amend": 1
  },
  {
   "role": "EPM Admin",
   "read": 1,
   "write": 1,
   "submit": 1,
   "cancel": 1,
   "report": 1,
   "print": 1,
   "export": 1,
   "email": 1
  },
  {
   "role": "EPM Analyst",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "report": 1,
   "print": 1,
   "export": 1,
   "email": 1,
   "amend": 1
  },
  {
   "role": "EPM User",
   "read": 1,
   "report": 1,
   "print": 1,
   "export": 1,
   "email": 1
  }
 ]
}
