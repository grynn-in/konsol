{
 "name": "Cost Allocation Statistic",
 "doctype": "DocType",
 "module": "EPM",
 "issingle": 0,
 "istable": 0,
 "is_submittable": 1,
 "editable_grid": 0,
 "engine": "InnoDB",
 "track_changes": 1,
 "autoname": "format:CAS-{#####}",
 "title_field": "driver",
 "search_fields": "entity,scenario,fiscal_year",
 "fields": [
  {
   "fieldname": "tab_statistic",
   "fieldtype": "Tab Break",
   "label": "Statistic"
  },
  {
   "fieldname": "scope_section",
   "fieldtype": "Section Break",
   "label": "Scope"
  },
  {
   "fieldname": "driver",
   "fieldtype": "Link",
   "label": "Driver",
   "options": "Cost Allocation Driver",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1,
   "description": "The driver this statistic supplies values for, e.g. Headcount."
  },
  {
   "fieldname": "dimension",
   "fieldtype": "Link",
   "label": "Dimension",
   "options": "Dimension",
   "fetch_from": "driver.dimension",
   "read_only": 1,
   "description": "Fetched from the driver. Every member below must belong to this dimension."
  },
  {
   "fieldname": "col_break_scope",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "entity",
   "fieldtype": "Link",
   "label": "Entity",
   "options": "Entity",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1,
   "description": "The entity these values describe."
  },
  {
   "fieldname": "scenario",
   "fieldtype": "Link",
   "label": "Scenario",
   "options": "Scenario",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1,
   "description": "The scenario these values belong to. A statistic for an actual scenario is held to the period close; any other scenario type is not."
  },
  {
   "fieldname": "fiscal_year",
   "fieldtype": "Int",
   "label": "Fiscal Year",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1,
   "description": "Every period in the Values table must be a declared period of this fiscal year."
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "Draft\nPending Approval\nApproved\nCancelled",
   "default": "Draft",
   "read_only": 1,
   "in_list_view": 1,
   "in_standard_filter": 1,
   "description": "Set by the workflow: Approved is the submitted document, Cancelled the cancelled one."
  },
  {
   "fieldname": "amended_from",
   "fieldtype": "Link",
   "label": "Amended From",
   "options": "Cost Allocation Statistic",
   "no_copy": 1,
   "print_hide": 1,
   "read_only": 1,
   "description": "The cancelled statistic this one replaces."
  },
  {
   "fieldname": "upload_section",
   "fieldtype": "Section Break",
   "label": "Upload"
  },
  {
   "fieldname": "values_file",
   "fieldtype": "Attach",
   "label": "Values File",
   "description": "CSV with the columns fiscal_period, member, value. Load replaces every row below, all or nothing."
  },
  {
   "fieldname": "col_break_upload",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "row_count",
   "fieldtype": "Int",
   "label": "Rows",
   "read_only": 1,
   "description": "Number of value rows, set on save."
  },
  {
   "fieldname": "total",
   "fieldtype": "Float",
   "label": "Total",
   "read_only": 1,
   "description": "Sum of all values, set on save. Totals across periods; a check on the load, not a figure to report."
  },
  {
   "fieldname": "tab_values",
   "fieldtype": "Tab Break",
   "label": "Values"
  },
  {
   "fieldname": "values_section",
   "fieldtype": "Section Break",
   "label": "Values"
  },
  {
   "fieldname": "values",
   "fieldtype": "Table",
   "label": "Values",
   "options": "Cost Allocation Statistic Value",
   "reqd": 1,
   "description": "One value per period and member. At most 20,000 rows."
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "submit": 1,
   "cancel": 1,
   "amend": 1
  },
  {
   "role": "EPM Admin",
   "read": 1,
   "write": 1,
   "submit": 1,
   "cancel": 1,
   "report": 1,
   "print": 1,
   "export": 1,
   "email": 1
  },
  {
   "role": "EPM Analyst",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "report": 1,
   "print": 1,
   "export": 1,
   "email": 1,
   "amend": 1
  },
  {
   "role": "EPM User",
   "read": 1,
   "report": 1,
   "print": 1,
   "export": 1,
   "email": 1
  }
 ]
}
