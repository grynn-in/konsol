{
  "name": "Measure",
  "doctype": "DocType",
  "module": "EPM",
  "issingle": 0,
  "istable": 0,
  "editable_grid": 0,
  "engine": "InnoDB",
  "track_changes": 1,
  "autoname": "field:measure_name",
  "fields": [
    {
      "fieldname": "measure_name",
      "fieldtype": "Data",
      "label": "Measure Name",
      "reqd": 1,
      "unique": 1,
      "in_list_view": 1,
      "description": "e.g. period_net_amount"
    },
    {
      "fieldname": "expression",
      "fieldtype": "Data",
      "label": "Expression",
      "reqd": 1,
      "in_list_view": 1,
      "description": "SQL expression, e.g. sum(accounting_currency_amount)"
    },
    {
      "fieldname": "col_break_1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "label",
      "fieldtype": "Data",
      "label": "Label",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "cube_type",
      "fieldtype": "Select",
      "label": "Cube Type",
      "options": "sum\ncount\navg",
      "default": "sum"
    },
    {
      "fieldname": "lifecycle_section",
      "fieldtype": "Section Break",
      "label": "Lifecycle"
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Status",
      "options": "Draft\nPublished\nInactive",
      "default": "Draft",
      "in_list_view": 1
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    },
    {
      "role": "EPM Admin",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    }
  ]
}
