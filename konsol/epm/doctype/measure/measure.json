{
  "name": "Measure",
  "doctype": "DocType",
  "module": "EPM",
  "issingle": 0,
  "istable": 0,
  "editable_grid": 0,
  "engine": "InnoDB",
  "track_changes": 1,
  "autoname": "field:measure_name",
  "fields": [
    {
      "fieldname": "measure_name",
      "fieldtype": "Data",
      "label": "Measure Name",
      "reqd": 1,
      "unique": 1,
      "in_list_view": 1,
      "description": "e.g. period_net_amount"
    },
    {
      "fieldname": "expression",
      "fieldtype": "Data",
      "label": "Expression",
      "reqd": 1,
      "in_list_view": 1,
      "description": "One SQL aggregate expression on one line, e.g. sum(accounting_currency_amount). When the Published trial-balance Dataset declares this measure, dbt compiles it into gold_trial_balance over epm_silver.silver_gl_entries, and konsol runs it there when you publish: a refusal lists the columns you can use."
    },
    {
      "fieldname": "col_break_1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "label",
      "fieldtype": "Data",
      "label": "Label",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "cube_type",
      "fieldtype": "Select",
      "label": "Cube Type",
      "options": "sum\ncount\navg\nlast",
      "default": "sum"
    },
    {
      "fieldname": "lifecycle_section",
      "fieldtype": "Section Break",
      "label": "Lifecycle"
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Status",
      "options": "Draft\nPublished\nInactive",
      "default": "Draft",
      "in_list_view": 1
    },
    {
      "fieldname": "expression_check",
      "fieldtype": "Small Text",
      "label": "Expression Check",
      "read_only": 1,
      "no_copy": 1,
      "description": "Set by konsol when the expression is published: Checked, Not checked (and why), or Not compiled. Publish again to re-check."
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    },
    {
      "export": 1,
      "role": "EPM Admin",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    }
  ]
}
