{
  "name": "Consolidation Adjustment",
  "doctype": "DocType",
  "module": "EPM",
  "issingle": 0,
  "istable": 0,
  "editable_grid": 1,
  "engine": "InnoDB",
  "track_changes": 1,
  "autoname": "format:CADJ-{journal_id}-{####}",
  "fields": [
    {
      "fieldname": "consolidation_group",
      "fieldtype": "Data",
      "label": "Consolidation Group",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "adjustment_type",
      "fieldtype": "Select",
      "label": "Adjustment Type",
      "options": "topside\nreclassification",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "journal_id",
      "fieldtype": "Data",
      "label": "Journal ID",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "col_break_1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "data_area_id",
      "fieldtype": "Data",
      "label": "Entity",
      "reqd": 1
    },
    {
      "fieldname": "fiscal_year",
      "fieldtype": "Int",
      "label": "Fiscal Year",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "fiscal_period",
      "fieldtype": "Int",
      "label": "Fiscal Period",
      "reqd": 1
    },
    {
      "fieldname": "main_account",
      "fieldtype": "Data",
      "label": "Main Account",
      "reqd": 1
    },
    {
      "fieldname": "amounts_section",
      "fieldtype": "Section Break",
      "label": "Amounts"
    },
    {
      "fieldname": "debit_amount",
      "fieldtype": "Currency",
      "label": "Debit Amount",
      "reqd": 1,
      "default": "0"
    },
    {
      "fieldname": "credit_amount",
      "fieldtype": "Currency",
      "label": "Credit Amount",
      "reqd": 1,
      "default": "0"
    },
    {
      "fieldname": "details_section",
      "fieldtype": "Section Break",
      "label": "Details"
    },
    {
      "fieldname": "description",
      "fieldtype": "Small Text",
      "label": "Description"
    },
    {
      "fieldname": "posted_by",
      "fieldtype": "Link",
      "label": "Posted By",
      "options": "User",
      "default": "__user"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    }
  ]
}
