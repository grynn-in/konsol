{
  "name": "Budget Input",
  "doctype": "DocType",
  "module": "EPM",
  "issingle": 0,
  "istable": 0,
  "editable_grid": 0,
  "engine": "InnoDB",
  "track_changes": 1,
  "autoname": "format:BUD-{scenario_id}-{data_area_id}-{fiscal_year}-{main_account}",
  "fields": [
    {
      "fieldname": "scenario_id",
      "fieldtype": "Link",
      "label": "Scenario",
      "options": "Scenario Definition",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "data_area_id",
      "fieldtype": "Data",
      "label": "Entity",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "fiscal_year",
      "fieldtype": "Int",
      "label": "Fiscal Year",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "col_break_1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "main_account",
      "fieldtype": "Data",
      "label": "Main Account",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "dim_cost_center",
      "fieldtype": "Data",
      "label": "Cost Center"
    },
    {
      "fieldname": "dim_department",
      "fieldtype": "Data",
      "label": "Department"
    },
    {
      "fieldname": "annual_amount",
      "fieldtype": "Currency",
      "label": "Annual Amount",
      "read_only": 1,
      "description": "Computed: sum of period amounts"
    },
    {
      "fieldname": "spread_section",
      "fieldtype": "Section Break",
      "label": "Spread"
    },
    {
      "fieldname": "spread_profile_id",
      "fieldtype": "Link",
      "label": "Spread Profile",
      "options": "Spread Profile",
      "description": "Optional: for top-down entry"
    },
    {
      "fieldname": "submitted_by",
      "fieldtype": "Link",
      "label": "Submitted By",
      "options": "User",
      "default": "__user"
    },
    {
      "fieldname": "periods_section",
      "fieldtype": "Section Break",
      "label": "Monthly Periods"
    },
    {
      "fieldname": "periods",
      "fieldtype": "Table",
      "label": "Periods",
      "options": "Budget Input Child",
      "reqd": 1
    },
    {
      "fieldname": "workflow_state",
      "fieldtype": "Data",
      "label": "Workflow State",
      "hidden": 1,
      "read_only": 1
    },
    {
      "fieldname": "d365_writeback_section",
      "fieldtype": "Section Break",
      "label": "D365 Write-Back",
      "collapsible": 1
    },
    {
      "fieldname": "d365_writeback_status",
      "fieldtype": "Select",
      "label": "D365 Write-Back Status",
      "options": "\nPushed\nFailed",
      "read_only": 1
    },
    {
      "fieldname": "d365_writeback_error",
      "fieldtype": "Small Text",
      "label": "D365 Write-Back Error",
      "read_only": 1
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "submit": 0
    },
    {
      "role": "Budget Submitter",
      "read": 1,
      "write": 1,
      "create": 1
    },
    {
      "role": "Budget Controller",
      "read": 1,
      "write": 1
    },
    {
      "role": "Budget Manager",
      "read": 1,
      "write": 1
    },
    {
      "role": "Budget Approver",
      "read": 1,
      "write": 1
    }
  ]
}
