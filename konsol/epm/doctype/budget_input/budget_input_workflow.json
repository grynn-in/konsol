{
  "name": "Budget Input Workflow",
  "doctype": "Workflow",
  "document_type": "Budget Input",
  "is_active": 1,
  "workflow_state_field": "workflow_state",
  "states": [
    {
      "state": "Draft",
      "doc_status": 0,
      "allow_edit": "Budget Submitter"
    },
    {
      "state": "Submitted",
      "doc_status": 0,
      "allow_edit": "Budget Controller"
    },
    {
      "state": "Approved",
      "doc_status": 0,
      "allow_edit": "Budget Approver"
    },
    {
      "state": "Rejected",
      "doc_status": 0,
      "allow_edit": "Budget Submitter"
    }
  ],
  "transitions": [
    {
      "state": "Draft",
      "action": "Submit for Review",
      "next_state": "Submitted",
      "allowed": "Budget Submitter"
    },
    {
      "state": "Submitted",
      "action": "Approve",
      "next_state": "Approved",
      "allowed": "Budget Approver"
    },
    {
      "state": "Submitted",
      "action": "Reject",
      "next_state": "Rejected",
      "allowed": "Budget Approver"
    },
    {
      "state": "Rejected",
      "action": "Resubmit",
      "next_state": "Submitted",
      "allowed": "Budget Submitter"
    }
  ]
}
