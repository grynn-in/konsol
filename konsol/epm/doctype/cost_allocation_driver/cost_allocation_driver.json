{
  "name": "Cost Allocation Driver",
  "doctype": "DocType",
  "module": "EPM",
  "issingle": 0,
  "istable": 0,
  "editable_grid": 0,
  "engine": "InnoDB",
  "track_changes": 1,
  "autoname": "field:driver_name",
  "title_field": "driver_name",
  "fields": [
    {
      "fieldname": "driver_tab",
      "fieldtype": "Tab Break",
      "label": "Driver"
    },
    {
      "fieldname": "driver_section",
      "fieldtype": "Section Break",
      "label": "Driver"
    },
    {
      "fieldname": "driver_name",
      "fieldtype": "Data",
      "label": "Driver Name",
      "reqd": 1,
      "unique": 1,
      "in_list_view": 1,
      "description": "The statistic a cost pool is spread on, e.g. Headcount or Floor Area."
    },
    {
      "fieldname": "dimension",
      "fieldtype": "Link",
      "label": "Dimension",
      "options": "Dimension",
      "reqd": 1,
      "in_list_view": 1,
      "description": "Must be Published. A Draft or Inactive dimension is refused."
    },
    {
      "fieldname": "unit",
      "fieldtype": "Data",
      "label": "Unit",
      "description": "e.g. FTE, m2. Display only."
    },
    {
      "fieldname": "col_break_1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "carry_forward",
      "fieldtype": "Check",
      "label": "Carry Forward",
      "description": "When a period has no value for a receiver, use its latest earlier period's value in the same scenario. Every carried value is reported on the run. Off: a missing value refuses the run."
    },
    {
      "fieldname": "is_active",
      "fieldtype": "Check",
      "label": "Active",
      "default": "1",
      "description": "An inactive driver cannot be used by a new rule."
    },
    {
      "fieldname": "description",
      "fieldtype": "Small Text",
      "label": "Description"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    },
    {
      "export": 1,
      "role": "EPM Admin",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    }
  ]
}
