{
  "name": "Budget Cycle",
  "doctype": "DocType",
  "module": "EPM",
  "issingle": 0,
  "istable": 0,
  "is_submittable": 1,
  "editable_grid": 0,
  "engine": "InnoDB",
  "track_changes": 1,
  "autoname": "",
  "fields": [
    {
      "fieldname": "cycle_tab",
      "fieldtype": "Tab Break",
      "label": "Cycle"
    },
    {
      "fieldname": "cycle_section",
      "fieldtype": "Section Break",
      "label": "Cycle"
    },
    {
      "fieldname": "scenario_id",
      "set_only_once": 1,
      "fieldtype": "Link",
      "label": "Scenario",
      "options": "Scenario",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "scenario_type",
      "fieldtype": "Data",
      "label": "Scenario Type",
      "fetch_from": "scenario_id.scenario_type",
      "read_only": 1,
      "in_list_view": 1,
      "in_standard_filter": 1,
      "description": "Copied from the Scenario: budget, forecast, strategic or operational. Read-only; the Planning sidebar lists budgets and forecasts by it (#443)."
    },
    {
      "fieldname": "fiscal_year",
      "set_only_once": 1,
      "fieldtype": "Int",
      "label": "Fiscal Year",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "col_break_1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "deadline",
      "fieldtype": "Date",
      "label": "Deadline",
      "description": "A target date; it locks nothing."
    },
    {
      "fieldname": "workflow_state",
      "fieldtype": "Link",
      "label": "Workflow State",
      "options": "Workflow State",
      "read_only": 1,
      "no_copy": 1,
      "allow_on_submit": 1,
      "in_list_view": 1,
      "in_standard_filter": 1,
      "description": "Set by the installed Budget Cycle workflow: Draft, Pending Approval, Approved. Approve is the submit."
    },
    {
      "fieldname": "amended_from",
      "fieldtype": "Link",
      "label": "Amended From",
      "options": "Budget Cycle",
      "read_only": 1,
      "no_copy": 1,
      "print_hide": 1,
      "search_index": 1
    },
    {
      "fieldname": "entries_tab",
      "fieldtype": "Tab Break",
      "label": "Entries"
    },
    {
      "fieldname": "summary_section",
      "fieldtype": "Section Break",
      "label": "Summary"
    },
    {
      "fieldname": "entry_count",
      "fieldtype": "Int",
      "label": "Entries",
      "read_only": 1,
      "no_copy": 1,
      "description": "The Budget Entries under this Cycle, counted when the Cycle is opened or saved."
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "submit": 1,
      "cancel": 1,
      "amend": 1,
      "report": 1,
      "export": 1,
      "print": 1,
      "email": 1,
      "share": 1
    },
    {
      "role": "EPM Admin",
      "read": 1,
      "write": 1,
      "create": 1,
      "submit": 1,
      "cancel": 1,
      "amend": 1,
      "report": 1,
      "export": 1,
      "print": 1
    },
    {
      "role": "EPM Analyst",
      "read": 1,
      "write": 1,
      "create": 1,
      "report": 1,
      "export": 1,
      "print": 1
    },
    {
      "role": "Entity Accountant",
      "read": 1,
      "report": 1,
      "print": 1,
      "export": 1,
      "email": 1
    },
    {
      "role": "EPM User",
      "read": 1,
      "report": 1,
      "print": 1,
      "export": 1
    }
  ],
  "search_fields": "scenario_id,fiscal_year"
}
