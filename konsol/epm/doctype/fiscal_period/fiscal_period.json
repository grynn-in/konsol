{
  "name": "Fiscal Period",
  "doctype": "DocType",
  "module": "EPM",
  "issingle": 0,
  "istable": 0,
  "editable_grid": 0,
  "engine": "InnoDB",
  "track_changes": 1,
  "autoname": "format:FP-{fiscal_period}",
  "fields": [
    {
      "fieldname": "fiscal_period",
      "fieldtype": "Int",
      "label": "Fiscal Period",
      "reqd": 1,
      "unique": 1,
      "in_list_view": 1,
      "description": "0=Opening, 1-12=Monthly, 13=Closing, 14=Adjustment"
    },
    {
      "fieldname": "label",
      "fieldtype": "Data",
      "label": "Label",
      "reqd": 1,
      "in_list_view": 1,
      "description": "e.g. OPN, P1...P12, CLS"
    },
    {
      "fieldname": "col_break_1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "quarter",
      "fieldtype": "Data",
      "label": "Quarter",
      "reqd": 1,
      "in_list_view": 1,
      "description": "e.g. OPN, Q1...Q4, CLS"
    },
    {
      "fieldname": "half",
      "fieldtype": "Data",
      "label": "Half",
      "reqd": 1,
      "in_list_view": 1,
      "description": "e.g. OPN, H1, H2, CLS"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    }
  ]
}
