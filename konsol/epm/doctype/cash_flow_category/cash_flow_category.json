{
  "name": "Cash Flow Category",
  "doctype": "DocType",
  "module": "EPM",
  "issingle": 0,
  "istable": 0,
  "editable_grid": 0,
  "engine": "InnoDB",
  "track_changes": 1,
  "autoname": "format:CFC-{main_account}",
  "naming_rule": "Expression",
  "fields": [
    {
      "fieldname": "main_account",
      "fieldtype": "Data",
      "label": "Main Account",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1,
      "description": "Balance-sheet GL account this mapping classifies (matches gold_bs_movement.main_account)"
    },
    {
      "fieldname": "cf_category",
      "fieldtype": "Select",
      "label": "Cash Flow Category",
      "options": "Operating\nInvesting\nFinancing",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1,
      "description": "Statement of cash flows section"
    },
    {
      "fieldname": "cf_line_item",
      "fieldtype": "Data",
      "label": "Cash Flow Line Item",
      "reqd": 1,
      "in_list_view": 1,
      "description": "Sub-line label, e.g. Change in Trade Receivables"
    },
    {
      "fieldname": "col_break_1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "is_cash",
      "fieldtype": "Check",
      "label": "Is Cash / Cash Equivalent",
      "default": "0",
      "in_list_view": 1,
      "description": "1 = the cash/cash-equivalent account itself (excluded from activity lines; defines the reconciliation target)"
    },
    {
      "fieldname": "sign",
      "fieldtype": "Select",
      "label": "Sign",
      "options": "1\n-1",
      "default": "1",
      "reqd": 1,
      "description": "+1 credit-natured (liabilities/equity/contra-assets), -1 debit-natured (assets/contra-equity)"
    },
    {
      "fieldname": "lifecycle_section",
      "fieldtype": "Section Break",
      "label": "Lifecycle"
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Status",
      "options": "Draft\nPublished\nInactive",
      "default": "Draft",
      "in_list_view": 1,
      "in_standard_filter": 1
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    },
    {
      "role": "EPM Admin",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    },
    {
      "role": "EPM Analyst",
      "read": 1,
      "create": 1
    },
    {
      "role": "EPM User",
      "read": 1
    }
  ]
}
